# Neon Postgres connection strings (both from the Neon "Connect" dialog).

# POOLED connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# DIRECT connection (same string with "-pooler" removed) — used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon's compute makes Prisma's migration advisory lock hang; disable it (safe for solo dev).
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK="1"
